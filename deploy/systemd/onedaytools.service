[Unit]
Description=OneDay Tools web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=onedaytools
Group=onedaytools
WorkingDirectory=/opt/onedaytools/current
EnvironmentFile=/etc/onedaytools.env
ExecStart=/usr/local/bin/node .next/standalone/server.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
